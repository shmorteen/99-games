# Local Docker Compose settings for KSA Games.
# Copy this file to .env for local container runs.

KSA_DEBUG=true
KSA_SECRET_KEY=django-insecure-compose-local-dev-change-me
KSA_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,web

KSA_DATABASE_ENGINE=postgresql
KSA_DB_NAME=ksa_games
KSA_DB_USER=ksa_games
KSA_DB_PASSWORD=ksa_games_dev_password
KSA_DB_HOST=db
KSA_DB_PORT=5432

KSA_REDIS_URL=redis://redis:6379/0
KSA_CHANNEL_PREFIX=ksa-games

KSA_CELERY_BROKER_URL=redis://redis:6379/1
KSA_CELERY_RESULT_BACKEND=redis://redis:6379/2
KSA_CELERY_TASK_DEFAULT_QUEUE=ksa-games
KSA_CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true

KSA_GOOGLE_OAUTH_CLIENT_ID=
KSA_GOOGLE_OAUTH_CLIENT_SECRET=
